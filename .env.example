# ==============================================================================
# Hyunk AI Hub - Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# WARNING: NEVER commit .env or .env.local to version control.
# ==============================================================================

# --- AI Provider API Credentials (Server-Side Only) ---
# Supports multiple keys separated by comma, semicolon, or newline (e.g. key1,key2,key3)
# You can also use RADOX_API_KEYS and INKSTONE_API_KEYS
# Radox AI: https://radoxai.com/v1
RADOX_API_KEY=your_radox_api_key_here
# RADOX_API_KEYS=key1,key2,key3

# Intern InkStone: https://discovery-api.intern-ai.org.cn/v1
INKSTONE_API_KEY=your_inkstone_api_key_here
# INKSTONE_API_KEYS=key1,key2,key3

# --- Supabase Database & Auth (Optional for local memory mode) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Secret Encryption at Rest (AES-256-GCM) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-character hex string (32 bytes).
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Role & Tier Quotas (Optional) ---
# The role of an account (admin / free / premium1..premium4) decides how many
# AI requests it may send per day, how long an answer may be and which models
# it may use. Every value can be tuned here, the defaults are the ones of the
# specification:
#   free     :  20 request / hari,  2048 token,  10 pesan riwayat
#   premium1 : 100 request / hari,  4096 token,  30 pesan riwayat
#   premium2 : 200 request / hari,  8192 token,  50 pesan riwayat
#   premium3 : 500 request / hari, 16000 token,  80 pesan riwayat
#   premium4 : 1000 request / hari, 32000 token, 100 pesan riwayat
#   admin    : tanpa batas,        32000 token, 100 pesan riwayat
FREE_DAILY_REQUEST_LIMIT=20
PREMIUM1_DAILY_REQUEST_LIMIT=100
PREMIUM2_DAILY_REQUEST_LIMIT=200
PREMIUM3_DAILY_REQUEST_LIMIT=500
PREMIUM4_DAILY_REQUEST_LIMIT=1000
# ADMIN_DAILY_REQUEST_LIMIT=0        # 0 atau kosong = tanpa batas

# Panjang maksimum jawaban dan jumlah pesan riwayat per tier (opsional).
# FREE_MAX_TOKENS=2048
# PREMIUM2_MAX_TOKENS=8192
# FREE_MAX_CONTEXT_MESSAGES=10
# PREMIUM4_MAX_CONTEXT_MESSAGES=100

# --- Live Web Search (Optional, Recommended) ---
# The web search runs in tiers: a real search API first, then the free
# DuckDuckGo / Mojeek / Wikipedia fallbacks. Configure ONE of the keys below
# to get the best (and the freshest) results - without a key the free tiers
# are used, they work but they are less reliable.
#
# Brave Search API (free tier: 2000 queries/month): https://brave.com/search/api
BRAVE_SEARCH_API_KEY=
# Tavily (built for LLMs): https://tavily.com
TAVILY_API_KEY=
# Serper.dev (Google results + news): https://serper.dev
SERPER_API_KEY=
# Google Programmable Search (both values are required):
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# The time budget of the whole search chain (milliseconds). When it is
# exhausted only the cheap DuckDuckGo instant answer still runs.
# WEB_SEARCH_BUDGET_MS=15000

# --- Application Configuration ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Hyunk AI Hub"
