<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- App Metadata -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>HyunkAIHub</AssemblyName>
    <RootNamespace>HyunkAIHub</RootNamespace>
    <AssemblyTitle>Hyunk AI Hub</AssemblyTitle>
    <AssemblyDescription>Hyunk AI Hub - Next Generation AI Chat Platform</AssemblyDescription>
    <AssemblyCompany>Hyunk Labs</AssemblyCompany>
    <AssemblyProduct>Hyunk AI Hub</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2026 Hyunk Labs</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Single file publish optimizations -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
